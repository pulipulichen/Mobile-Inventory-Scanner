# Public Google OAuth client ID for browser-based Sheets API access.
# Never put a client secret or service-account key in this file.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional. Use a full URL when scan is deployed on another site.
# Leave unset to use ../scan/ for same-domain deployments.
VITE_SCAN_APP_URL=
